#!/usr/bin/env bash
set -euo pipefail

case ${1:-status} in
    status)
        cat "${XDG_RUNTIME_DIR:-/tmp}/gimbal-sp4-mode"
        ;;
    cover)
        # attached, detached, folded or unknown, then what reports the fold:
        # the tablet-mode switch's posture on a Surface that has one (the
        # SP9), otherwise the optional fold helper's word or not running.
        # Only known words are printed, never raw file contents.
        cover=$(head -c 16 "${XDG_RUNTIME_DIR:-/tmp}/gimbal-sp4-cover" 2>/dev/null || true)
        case $cover in
            attached|detached|folded|unknown) echo "$cover" ;;
            *) echo unknown ;;
        esac
        switch=$(head -c 16 "${XDG_RUNTIME_DIR:-/tmp}/gimbal-sp4-cover-switch" 2>/dev/null || true)
        if [[ $switch == present ]]; then
            for state in /sys/bus/surface_aggregator/drivers/surface_aggregator_tablet_mode_switch/*/state; do
                posture=$(head -c 32 "$state" 2>/dev/null || true)
                case $posture in
                    disconnected|closed|laptop|folded-canvas|folded-back|book|slate|tablet) ;;
                    *) posture='unreadable' ;;
                esac
                echo "tablet-mode switch: $posture"
                exit 0
            done
            echo 'tablet-mode switch: unreadable'
            exit 0
        fi
        if [[ -e /run/gimbal-sp4-cover/fold ]]; then
            fold=$(head -c 16 /run/gimbal-sp4-cover/fold 2>/dev/null || true)
            case $fold in
                typing|between|folded|unknown) ;;
                *) fold='unreadable' ;;
            esac
        else
            fold='not running'
        fi
        echo "fold helper: $fold"
        ;;
    toggle)
        hyprctl eval 'require("hypr.gimbal_sp4").toggle()'
        ;;
    tablet|laptop)
        hyprctl eval "require(\"hypr.gimbal_sp4\").set(\"$1\")"
        ;;
    *)
        echo 'Usage: gimbal-sp4-mode [status|cover|toggle|tablet|laptop]' >&2
        exit 2
        ;;
esac
